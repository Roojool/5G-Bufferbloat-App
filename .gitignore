# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
# Local Gradle distributions are reproducible via the wrapper and must not be versioned.
gradle-[0-9]*/

# IDE
.idea/
*.iml
local.properties

# Local environment and signing material — never publish credentials.
.env
.env.*
!.env.example
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key

# Build outputs
app/build/
app/release/
*.apk
*.aab
*.hprof

# Android native build, profiling, and captured-device output
.cxx/
.externalNativeBuild/
captures/
diagnostics/
local-diagnostics/
logs/
*.pcap
*.pcapng
*.cap

# Local diagnostic output
build_error.log

# OS
.DS_Store
Thumbs.db
