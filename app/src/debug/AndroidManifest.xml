<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity android:name=".harness.HarnessActivity" android:exported="true"
            android:label="Internal socket experiment — no VPN route" />
        <activity android:name=".harness.BatchHarnessActivity" android:exported="true"
            android:excludeFromRecents="true" android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:label="Internal socket batch — no VPN route" />
        <service android:name=".harness.HarnessService" android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter><action android:name="android.net.VpnService" /></intent-filter>
            <meta-data android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON" android:value="false" />
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Debug-only bound socket experiment service. No foreground restart and no VPN route." />
        </service>
    </application>
</manifest>
